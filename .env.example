# Chave da API Last.fm — obtenha em https://www.last.fm/api/account/create
LASTFM_API_KEY=sua_chave_aqui

# Origem permitida para o CORS (URL do seu site no Vercel, sem barra no final)
# Exemplo: https://radio-estancia.vercel.app
# Deixe vazio para liberar todas as origens (não recomendado em produção)
ALLOWED_ORIGIN=https://player-radio-adapted.vercel.app
